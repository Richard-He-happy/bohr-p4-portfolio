  "cues": [
    [
      "\\bwe (?:use[sd]?|employ\\w*|appl(?:y|ied)|adopt\\w*|select\\w*)\\b",
      "uses"
    ],
    [
      "\\b(?:using|used|based on|via|by means of|prepared by|synthesi[sz]ed (?:by|with|from))\\b",
      "uses"
    ],
    [
      "\\b(?:outperform\\w*|better than|superior to|higher than|lower than|improved? over|faster than)\\b",
      "improves_over"
    ],
    [
      "\\b(?:compared (?:with|to)|in comparison (?:with|to)|versus|vs\\.)\\b",
      "compared_with"
    ],
    [
      "\\b(?:consistent with|agrees? with|in line with|corroborat\\w+|replicat\\w+)\\b",
      "consistent_with"
    ],
    [
      "\\b(?:contradict\\w*|in contrast|disagree\\w*|conflicts? with)\\b",
      "contradicts"
    ],
    [
      "\\b(?:evaluat\\w+|measur\\w+|assess\\w+|quantif\\w+|tested)\\b",
      "measures"
    ],
    [
      "\\b(?:consists? of|composed of|derived from|defined as|refers to)\\b",
      "is_a"
    ],
    [
      "\\b(?:appl(?:y|ies|ied)|employ(?:s|ed|ing)?|utili[sz]\\w*)\\b",
      "uses"
    ],
    [
      "\\b(?:characteri[sz]ed by|measured by|assessed by|estimated (?:by|from)|derived from)\\b",
      "measures"
    ],
    [
      "\\b(?:was|is|were|are) (?:lower|higher|greater|smaller|better) than\\b",
      "improves_over"
    ],
    [
      "\\b(?:remained at|reached|amounted to)\\b",
      "measures"
    ],
    [
      "\\b(?:no significant difference|did not differ|similar to)\\b",
      "consistent_with"
    ]
  ],
