{
 "version": "1.0.0",
 "description": "Machine-readable rule table for library-auto-organizer. Loaded by scripts/organize.py; see references/method.md for rationale and examples.",
 "taxonomy": [
  {"key": "journal_article", "dir": "10_papers", "level2": "year", "when": "DOI plus article text or explicit journal/publisher metadata"},
  {"key": "preprint", "dir": "11_preprints", "level2": "year", "when": "arXiv/bioRxiv/medRxiv/SSRN/ChemRxiv id or server name, or 'preprint' in title/filename"},
  {"key": "conference_paper", "dir": "12_conference", "level2": "year", "when": "proceedings/conference/workshop/symposium wording"},
  {"key": "thesis", "dir": "13_thesis", "level2": "year", "when": "thesis/dissertation/学位论文 wording"},
  {"key": "supplementary", "dir": "14_supplementary", "level2": "none", "when": "supplement/supporting information/appendix wording"},
  {"key": "dataset", "dir": "20_datasets", "level2": "none", "when": "tabular, sequence or archive data extension without article metadata"},
  {"key": "metadata_table", "dir": "20_datasets/metadata_tables", "level2": "none", "when": "BibTeX/RIS or a table whose header names a file column"},
  {"key": "scan", "dir": "30_scans", "level2": "none", "when": "image file, or PDF with no extractable text layer"},
  {"key": "note", "dir": "40_notes", "level2": "none", "when": "markdown/text/DOCX prose without article metadata"},
  {"key": "code", "dir": "50_code", "level2": "none", "when": "source code or notebook extension"},
  {"key": "unknown", "dir": "00_inbox", "level2": "none", "when": "no decisive signal: kept in inbox for human review"},
  {"key": "quarantine", "dir": "90_quarantine", "level2": "none", "when": "unreadable, corrupt or encrypted file"},
  {"key": "duplicate", "dir": "91_duplicates", "level2": "sha256 prefix", "when": "byte-identical copy of a keeper file"},
  {"key": "superseded", "dir": "92_superseded", "level2": "chain id", "when": "older version inside a version chain"}
 ],
 "dirs": {"journal_article": "10_papers", "preprint": "11_preprints", "conference_paper": "12_conference", "thesis": "13_thesis",
          "supplementary": "14_supplementary", "book_chapter": "15_books_chapters", "dataset": "20_datasets", "scan": "30_scans",
          "note": "40_notes", "code": "50_code", "metadata_table": "20_datasets/metadata_tables", "other": "00_inbox", "unknown": "00_inbox"},
 "special": {"quarantine": "90_quarantine", "duplicates": "91_duplicates", "superseded": "92_superseded"},
 "naming": {"template": "{year}-{author}-{title}-{doctype}", "max_length": 150, "title_chars": 70,
            "missing": {"year": "nd", "author": "anon", "title": "untitled", "venue": "nvenue"},
            "rules": ["NFKC normalise; replace \\ / : * ? \" < > | and control characters with '-'",
                      "collapse whitespace and repeated dashes; strip leading/trailing '-._'",
                      "cap the title token at title_chars, the whole name at max_length",
                      "keep CJK characters as-is; no transliteration, no invented romanisation",
                      "year must be 4 digits else 'nd'; author token 'anon' when absent; title 'untitled'",
                      "sha256[:8] suffix added only on target-name collision",
                      "'x-' prefix for Windows reserved names (con, prn, aux, nul, com1-9, lpt1-9)"]},
 "patterns": [["preprint", "(biorxiv|medrxiv|arxiv|ssrn|chemrxiv|preprint)"],
              ["thesis", "(thesis|dissertation|学位论文)"],
              ["supplementary", "(supplement\\w*|supporting information|appendix|补充材料)"],
              ["conference_paper", "(proceedings|conference|workshop|symposium|会议)"],
              ["book_chapter", "(book chapter|isbn)"]],
 "doc_types": {"journalarticle": "journal_article", "preprint": "preprint", "manuscript": "preprint", "conferencepaper": "conference_paper",
               "thesis": "thesis", "book": "book_chapter", "booksection": "book_chapter", "dataset": "dataset", "note": "note"},
 "dedup": {"exact": "identical sha256 -> one keeper, other copies archived under 91_duplicates/<sha8>/ (copied, never deleted)",
           "keeper_order": ["shallower source path", "earlier mtime", "lexical path"],
           "version_keys": ["doi", "arxiv_id", "normalized title + year"],
           "version_roles": {"journal_article": "published", "conference_paper": "published", "thesis": "published",
                             "preprint": "preprint", "supplementary": "supplement"},
           "keep_rule": "published version if present, else latest file; superseded copies go to 92_superseded/<chain>/",
           "no_delete": true},
 "limits": {"tag_max": 8, "pdf_cap": 6000000, "head": 200000, "ev_cap": 200},
 "aliases": [["inv_csv", ["csv"]],
             ["inv", ["invent", "file_list", "filelist", "files", "manifest", "catalog", "index", "listing", "items"]],
             ["cls", ["classif", "categor", "director", "folder", "placement", "belong", "shelv"]],
             ["tags", ["tag", "label", "keyword", "theme", "topic"]],
             ["nm", ["name", "rename", "filename"]],
             ["dups", ["dup", "dedup", "redundan"]],
             ["vers", ["version", "revision", "preprint", "chain", "supersed"]],
             ["ops", ["operat", "log", "change", "audit", "action", "history", "move"]],
             ["meta", ["metadata", "biblio", "field", "citation"]],
             ["ev", ["evid", "provenance", "locat", "quote", "trace"]],
             ["unc", ["uncertain", "limitation", "risk", "ambigu", "caveat"]],
             ["pend", ["pending", "human", "manual", "confirm", "review"]],
             ["err", ["error", "fail", "exception", "skip", "problem"]],
             ["status", ["status", "state", "outcome"]],
             ["tree", ["tree", "hierarch", "structure", "layout"]],
             ["cov", ["coverage", "complete", "missing", "gap", "count", "stat", "summary", "overview"]]],
 "vocab": [
  {"tag": "machine-learning", "group": "method", "synonyms": ["machine learning", "deep learning", "neural network", "neural networks", "transformer"]},
  {"tag": "statistical-model", "group": "method", "synonyms": ["regression model", "statistical model", "bayesian model", "mixed model"]},
  {"tag": "systematic-review", "group": "study", "synonyms": ["systematic review", "meta-analysis", "meta analysis"]},
  {"tag": "clinical-trial", "group": "study", "synonyms": ["clinical trial", "randomized controlled trial", "randomised controlled trial", "rct"]},
  {"tag": "cohort-study", "group": "study", "synonyms": ["cohort study", "longitudinal study", "prospective cohort"]},
  {"tag": "case-control", "group": "study", "synonyms": ["case-control", "case control"]},
  {"tag": "in-vivo", "group": "study", "synonyms": ["in vivo", "animal model", "mouse model", "murine"]},
  {"tag": "in-vitro", "group": "study", "synonyms": ["in vitro", "cell culture", "cell line"]},
  {"tag": "genomics", "group": "subject", "synonyms": ["genomics", "whole genome", "genome-wide", "gwas"]},
  {"tag": "transcriptomics", "group": "subject", "synonyms": ["transcriptomics", "rna-seq", "rna sequencing", "single-cell rna"]},
  {"tag": "proteomics", "group": "subject", "synonyms": ["proteomics", "mass spectrometry", "proteome"]},
  {"tag": "metabolomics", "group": "subject", "synonyms": ["metabolomics", "metabolite profiling"]},
  {"tag": "microbiome", "group": "subject", "synonyms": ["microbiome", "microbiota", "16s rrna"]},
  {"tag": "crispr", "group": "method", "synonyms": ["crispr", "cas9", "gene editing"]},
  {"tag": "imaging", "group": "method", "synonyms": ["imaging", "microscopy", "mri", "ct scan", "fluorescence"]},
  {"tag": "spectroscopy", "group": "method", "synonyms": ["spectroscopy", "nmr", "xrd", "raman", "ftir", "x-ray diffraction"]},
  {"tag": "simulation", "group": "method", "synonyms": ["simulation", "molecular dynamics", "density functional theory", "dft", "finite element"]},
  {"tag": "materials", "group": "subject", "synonyms": ["materials", "alloy", "polymer", "nanoparticle", "thin film", "catalyst", "catalysis"]},
  {"tag": "neuroscience", "group": "subject", "synonyms": ["neuroscience", "neuron", "brain", "cortex", "synaptic"]},
  {"tag": "oncology", "group": "subject", "synonyms": ["oncology", "cancer", "tumour", "tumor", "carcinoma"]},
  {"tag": "immunology", "group": "subject", "synonyms": ["immunology", "immune", "antibody", "t cell", "cytokine"]},
  {"tag": "ecology", "group": "subject", "synonyms": ["ecology", "ecosystem", "biodiversity", "field survey"]},
  {"tag": "epidemiology", "group": "subject", "synonyms": ["epidemiology", "incidence", "prevalence", "outbreak"]},
  {"tag": "protein-structure", "group": "subject", "synonyms": ["protein structure", "protein folding", "crystal structure", "alphafold"]},
  {"tag": "benchmark", "group": "type", "synonyms": ["benchmark", "benchmarking", "evaluation suite"]},
  {"tag": "protocol", "group": "type", "synonyms": ["protocol", "standard operating procedure", "sop", "methods section"]},
  {"tag": "dataset", "group": "type", "synonyms": ["dataset", "data set", "data release", "supplementary data"]},
  {"tag": "review", "group": "type", "synonyms": ["review article", "literature review", "overview of"]}
 ]
}
