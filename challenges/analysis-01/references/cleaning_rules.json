{
 "version": "1.0.0",
 "scope": "Field-level cleaning rules for transcribed scientific tables with injected storage/encoding faults. Values are never statistically imputed by default.",
 "policy_default": "repair_and_flag",
 "missing_tokens": {
  "missing_blank": [
   "",
   "na",
   "n/a",
   "n.a.",
   "n.a",
   "nan",
   "null",
   "none",
   "nil",
   "-",
   "--",
   "---",
   ".",
   "?",
   "nr",
   "n.r.",
   "缺",
   "缺失",
   "未填",
   "无",
   "空白",
   "not available",
   "not reported",
   "不可用"
  ],
  "not_detected": [
   "nd",
   "n.d.",
   "nd.",
   "not detected",
   "not-detected",
   "notdetected",
   "未检出",
   "未检测",
   "n/d",
   "n.d",
   "nd (not detected)"
  ],
  "below_loq": [
   "bdl",
   "bql",
   "<lod",
   "<loq",
   "<dl",
   "<l od",
   "below lod",
   "below loq",
   "低于检出限",
   "低于定量限",
   "trace",
   "tr"
  ],
  "sentinel": [
   "-999",
   "-9999",
   "-999.0",
   "-9999.0",
   "-99",
   "-99.0",
   "9999",
   "99999",
   "999999",
   "-1e99",
   "1e99",
   "1e+99",
   "-1e+99"
  ],
  "explicit_zero_keep": [
   "0",
   "0.0",
   "0.00",
   "nd(0)",
   "n.d.(0)"
  ],
  "note": "sentinel tokens are only treated as missing when outside every declared/physical bound; explicit_zero_keep is never converted to missing."
 },
 "fault_codes": {
  "M1_missing_blank": {
   "class": "missing",
   "default_action": "set null + reason code",
   "note": "empty or placeholder token, cause unknown"
  },
  "M2_not_detected": {
   "class": "missing",
   "default_action": "set null + censored flag ND",
   "note": "measurement not detected; not equal to zero"
  },
  "M3_below_loq": {
   "class": "missing",
   "default_action": "set null + censored flag <LOQ",
   "note": "censored value, unusable for means without a censoring model"
  },
  "M4_sentinel": {
   "class": "missing",
   "default_action": "set null + reason sentinel_code",
   "note": "instrument/storage missing code (e.g. -999) distinct from a real reading"
  },
  "F1_numeric_format": {
   "class": "format",
   "default_action": "canonicalise to plain decimal, record original",
   "note": "decimal comma, thousands separator, sci notation, trailing unit, footnote marker, full-width digits, unicode minus"
  },
  "F2_date_format": {
   "class": "format",
   "default_action": "canonicalise to ISO 8601, record parsed pattern",
   "note": "mixed d/m/Y and Y-m-d, missing timezone"
  },
  "F3_encoding": {
   "class": "format",
   "default_action": "re-decode and record reversible mapping",
   "note": "GBK read as latin-1 mojibake, BOM, replacement chars"
  },
  "U1_unit_inconsistent": {
   "class": "format",
   "default_action": "convert to dictionary canonical unit, keep factor + original",
   "note": "same metric reported in mg/L and ug/mL etc."
  },
  "U2_unit_ambiguous": {
   "class": "format",
   "default_action": "keep value, flag, escalate to human",
   "note": "ppm without matrix context, unknown unit token"
  },
  "D1_duplicate_exact": {
   "class": "duplicate",
   "default_action": "remove later copies, quarantine row",
   "note": "byte-identical data record"
  },
  "D2_duplicate_key": {
   "class": "duplicate",
   "default_action": "remove later copies, keep most complete row",
   "note": "same normalised composite primary key"
  },
  "D3_near_duplicate": {
   "class": "duplicate",
   "default_action": "do not remove, escalate to human",
   "note": "key differs only by separators/case/leading zeros/unit spelling"
  },
  "R1_range_violation": {
   "class": "outlier",
   "default_action": "keep value, flag, do not delete",
   "note": "outside data-dictionary physical bound"
  },
  "R2_distribution_outlier": {
   "class": "outlier",
   "default_action": "keep value, flag robust MAD z",
   "note": "statistical outlier; may be a genuine extreme"
  },
  "T1_type_conflict": {
   "class": "return",
   "default_action": "keep raw text, flag",
   "note": "unparseable value in a numeric column, range '1.2-1.5', '1.5 +- 0.2'"
  }
 },
